local currentSection = "Main Menu"
local sections = {}

local function sectionExists(s)
    if typeof(sections[s]) ~= "table" then return false end
    return next(sections[s]) ~= nil
end

local function isButtonActive(b)
    local s = b:FindFirstChild("State")
    if not s then err("[isButtonActive] no State BoolValue found") end
    return  s.Value
end

local function addBtn(parentSection,text,initialState,toggle,func)
    if not sectionExists(parentSection) then
        err("[addBtn] parent section does not exist")
        return false
    end
    local button = Instance.new("TextButton",sections[parentSection].frame)
    button.Text = text
    button.BackgroundColor3 = if toggle then if initialState then settings.Theme.OnButtonClr else settings.Theme.OffButtonClr else settings.Theme.OffButtonClr
    button.Size = UDim2.fromScale(1,.1)
    button.TextColor3 = settings.Theme.ButtonTextClr
    button.TextScaled = true
    local stateValue
    if toggle then
        stateValue = Instance.new("BoolValue",button)
        stateValue.Name = "State"
    end
    button.Activated:Connect(function()
        if toggle then
            if not stateValue.Parent then err("[addBtn] State BoolValue not found") return false end
            stateValue.Value = not stateValue.Value
            button.BackgroundColor3 = if stateValue.Value then settings.Theme.OnButtonClr else settings.Theme.OffButtonClr
            func(stateValue.Value)
        else
            func()
        end
    end)

    return button
end

