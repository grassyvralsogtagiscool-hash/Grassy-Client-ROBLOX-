local function changeSection(s)
    local old = sections[currentSection]
    if not old then err("[changeSection] current section is invalid") return false end
    old = old.frame
    if not old then err("[changeSection] current section does not have a frame") return false end
    local new = sections[s]
    if not new then err("[changeSection] new section is invalid") return false end
    new = new.frame
    if not new then err("[changeSection] new section does not have a frame") return false end
    old.Visible = false
    new.Visible = true
    currentSection = s
    sectionlabel.Text = s
    return true
end

local function addBackBtn(parentSection,section)
    return addBtn(section,"Back to "..parentSection,false,false,function()
        changeSection(parentSection)
    end)
end

local function addSectionBtn(parentSection,section)
    return addBtn(parentSection,section,false,false,function()
        changeSection(section)
    end)
end

local function getSectionFrameTemplate(section)
    local f = template:Clone()
    f.Parent = bar
    f.Name = section
    f.Visible = false
    return f
end

sections["Main Menu"] = {
    frame = frame,
    sectionBtns = {}
}

local function addSection(parentSection,section)
    if not sectionExists(parentSection) then err("[addSection] parent section is invalid") return false end
    sections[section] = {}
    local f = getSectionFrameTemplate(section)
    sections[section].frame = f
    sections[section].sectionBtns = {}
    table.insert(sections[section].sectionBtns,addSectionBtn(parentSection,section))
    addBackBtn(parentSection,section)
    return f
end

local function addInput(parentSection,initialText,placeholderText,cleartextonfocus,onChanged,onEnter)
    if not sectionExists(parentSection) then err("[addInput] parent section is invalid") return false end
    if not sections[parentSection].frame then err("[addinput] parent section has no frame") return false end
    local textbox = Instance.new("TextBox",sections[parentSection].frame)
    textbox.Text = initialText
    textbox.PlaceholderText = placeholderText
    textbox.ClearTextOnFocus = cleartextonfocus
    textbox.Size = UDim2.fromScale(1,.1)
    textbox.BackgroundColor3 = settings.Theme.TextBoxClr
    textbox.TextColor3 = settings.Theme.TextBoxTextClr
    textbox.PlaceholderColor3 = settings.Theme.TextBoxPlaceholderTextClr
    textbox.TextScaled = true
    if typeof(onChanged) == "function" then
        textbox:GetPropertyChangedSignal("Text"):Connect(function() onChanged(textbox) end)
    end
    if typeof(onEnter) == "function" then
        textbox.FocusLost:Connect(function(enterPressed)
            if enterPressed then onEnter(textbox) end
        end)
    end
end

