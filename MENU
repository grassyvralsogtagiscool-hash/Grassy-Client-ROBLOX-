local tinteract
local InteractDistance = 10 -- default

addBtn("Advantage","Auto-Interact",false,true,function(state)
    if tinteract then
        tinteract:Disconnect()
        tinteract = nil
    end

    if state then
        tinteract = game:GetService("RunService").Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            for _, prompt in ipairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    local parent = prompt.Parent
                    local part = nil

                    if parent:IsA("BasePart") then
                        part = parent
                    elseif parent.Parent and parent.Parent:IsA("BasePart") then
                        part = parent.Parent
                    end

                    if part then
                        local dist = (hrp.Position - part.Position).Magnitude

                        if dist <= InteractDistance then
                            -- HOLD or PRESS depending on prompt type
                            pcall(function()
                                if prompt.HoldDuration > 0 then
                                    -- HOLD E
                                    prompt:InputHoldBegin()
                                else
                                    -- PRESS E
                                    prompt:InputHoldBegin()
                                    task.wait(0.05)
                                    prompt:InputHoldEnd()
                                end
                            end)
                        else
                            -- STOP HOLDING if we walk away
                            pcall(function()
                                prompt:InputHoldEnd()
                            end)
                        end
                    end
                end
            end
        end)
    else
        -- stop holding E on all prompts
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    prompt:InputHoldEnd()
                end)
            end
        end
    end
end)

